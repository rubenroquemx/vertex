{
  "name": "vertex-app",
  "version": "1.1.0",
  "private": true,
  "description": "VERTEX - Sistema multinivel de administración de estructura territorial electoral (PWA)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch-path=server.js --watch-path=src server.js",
    "icons": "node scripts/generate-icons.js",
    "empaquetar": "node scripts/empaquetar.js",
    "exportar-cuentas": "node scripts/exportar-cuentas.js",
    "datos-ejemplo": "node --env-file-if-exists=.env scripts/datos-ejemplo.js",
    "test": "node --env-file-if-exists=.env --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@webrek/mx-cp": "^0.2.0",
    "adm-zip": "^0.6.1",
    "aws4fetch": "^1.0.20",
    "compression": "^1.7.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "proj4": "^2.12.1",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
