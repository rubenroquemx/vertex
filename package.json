{
  "name": "vertex-app",
  "version": "0.1.0",
  "private": true,
  "description": "VERTEX - Sistema multinivel de administración de estructura territorial electoral (PWA)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch-path=server.js --watch-path=src server.js",
    "icons": "node scripts/generate-icons.js",
    "empaquetar": "node scripts/empaquetar.js",
    "exportar-cuentas": "node scripts/exportar-cuentas.js",
    "datos-ejemplo": "node --env-file-if-exists=.env scripts/datos-ejemplo.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@webrek/mx-cp": "^0.2.0",
    "adm-zip": "^0.5.16",
    "compression": "^1.7.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "proj4": "^2.12.1",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  }
}
